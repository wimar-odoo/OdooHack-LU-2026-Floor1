<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_garden_membership_fee_list" model="ir.ui.view">
        <field name="name">garden.membership.fee.list</field>
        <field name="model">garden.membership.fee</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="year"/>
                <field name="amount"/>
                <field name="payment_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_garden_membership_fee_form" model="ir.ui.view">
        <field name="name">garden.membership.fee.form</field>
        <field name="model">garden.membership.fee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_paid" type="object" string="Mark as Paid" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="year"/>
                            <field name="payment_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garden_membership_fee" model="ir.actions.act_window">
        <field name="name">Membership Fees</field>
        <field name="res_model">garden.membership.fee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>