<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="garden_membership_fee_view_list" model="ir.ui.view">
        <field name="name">garden.membership.fee.list</field>
        <field name="model">garden.membership.fee</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'draft'" decoration-success="state == 'paid'">
                <field name="partner_id"/>
                <field name="year"/>
                <field name="amount" sum="Total"/>
                <field name="payment_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'" decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="garden_membership_fee_view_form" model="ir.ui.view">
        <field name="name">garden.membership.fee.form</field>
        <field name="model">garden.membership.fee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_paid" type="object" string="Mark as paid"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="year" options="{'format': false}"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="payment_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="garden_membership_fee_view_search" model="ir.ui.view">
        <field name="name">garden.membership.fee.search</field>
        <field name="model">garden.membership.fee</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="year"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="this_year" string="This Year"
                        domain="[('year', '=', context_today().year)]"/>
                <filter name="group_by_year" string="Year" context="{'group_by': 'year'}"/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="garden_membership_fee_action" model="ir.actions.act_window">
        <field name="name">Membership Fees</field>
        <field name="res_model">garden.membership.fee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
