<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_garden" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.garden</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Bonus Smart Button -->
            <div name="button_box" position="inside">
                <button name="%(action_garden_membership_fee)d" type="action" class="oe_stat_button" icon="fa-money">
                    <field name="fee_count" widget="statinfo" string="Fees"/>
                </button>
            </div>

            <!-- Membership Tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Membership">
                    <group>
                        <group>
                            <field name="membership_type"/>
                            <field name="member_since"/>
                            <field name="last_paid_year"/>
                        </group>
                    </group>
                    <field name="fee_ids">
                        <list editable="bottom">
                            <field name="year"/>
                            <field name="amount"/>
                            <field name="payment_date"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Not Up To Date Search Filter -->
    <record id="view_res_partner_filter_inherit_garden" model="ir.ui.view">
        <field name="name">res.partner.select.inherit.garden</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="Not up to date" name="not_up_to_date" domain="[('last_paid_year', '!=', context_today().year)]"/>
            </xpath>
        </field>
    </record>
</odoo>