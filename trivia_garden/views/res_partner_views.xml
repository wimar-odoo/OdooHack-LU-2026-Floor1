<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- add a "Membership" tab to the existing contact form -->
    <record id="view_partner_form_garden" model="ir.ui.view">
        <field name="name">res.partner.form.garden</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Membership" name="garden_membership">
                    <group>
                        <group>
                            <field name="membership_type"/>
                            <field name="member_since"/>
                        </group>
                        <group>
                            <field name="last_paid_year"/>
                        </group>
                    </group>
                    <field name="fee_ids">
                        <list editable="bottom">
                            <field name="year"/>
                            <field name="amount"/>
                            <field name="payment_date"/>
                            <field name="state"/>
                            <button name="action_mark_paid" string="Mark as paid" type="object"
                                    icon="fa-check" invisible="state != 'draft'"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- add a "Not up to date" filter to the existing contacts search bar -->
    <record id="view_res_partner_filter_garden" model="ir.ui.view">
        <field name="name">res.partner.search.garden</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <search position="inside">
                <separator/>
                <filter name="not_up_to_date" string="Not up to date"
                        domain="[('membership_type', '!=', False), ('last_paid_year', '&lt;', context_today().year)]"/>
            </search>
        </field>
    </record>
</odoo>
