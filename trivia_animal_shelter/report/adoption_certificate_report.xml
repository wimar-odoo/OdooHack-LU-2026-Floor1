<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    TODO 6 - The adoption certificate

    A PDF report "Adoption Certificate" on the adoption requests (model shelter.adoption.request),
    printable from the form of a request (Print menu). It shows the name of the shelter, the name of
    the applicant, the animal (name, species, breed) and the date of the day.
    Tip: use the layout of the company documents, web.external_layout.
    -->
        <template id="report_adoption_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h1>Adoption Certificate</h1>
                        <h2>Refuge Les 4 Pattes</h2>

                        <p>Applicant:</p>
                        <h3 t-field="o.name"/>

                        <p>Animal details:</p>
                        <p>
                            <strong>Name:</strong>
                            <span t-field="o.animal_id.name"/>
                        </p>
                        <p>
                            <strong>Species:</strong>
                            <span t-field="o.animal_id.species"/>
                        </p>
                        <p>
                            <strong>Breed:</strong>
                            <span t-field="o.animal_id.breed"/>
                        </p>

                        <p>
                            <strong>Date:</strong>
                            <span t-out="time.strftime('%d/%m/%Y')"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_adoption_certificate"
            model="ir.actions.report">
        <field name="name">Adoption Certificate</field>
        <field name="model">shelter.adoption.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">trivia_animal_shelter.report_adoption_certificate</field>
        <field name="binding_model_id"
               ref="model_shelter_adoption_request"/>
    </record>
</odoo>
