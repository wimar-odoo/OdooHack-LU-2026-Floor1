<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_adoption_certificate" model="ir.actions.report">
        <field name="name">Adoption Certificate</field>
        <field name="model">shelter.adoption.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">trivia_animal_shelter.report_adoption_certificate</field>
        <field name="print_report_name">'Adoption Certificate - %s' % object.name</field>
        <field name="binding_model_id" ref="model_shelter_adoption_request"/>
    </record>

    <template id="report_adoption_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page text-center">
                        <h1>Adoption Certificate</h1>
                        <p class="mt-4">
                            <t t-out="o.env.company.name"/> certifies that
                            <b t-out="o.name"/> adopts
                            <b t-out="o.animal_id.name"/>
                            (<t t-out="o.animal_id.species_emoji"/> <t t-out="o.animal_id.species"/><t t-if="o.animal_id.breed">, <t t-out="o.animal_id.breed"/></t>).
                        </p>
                        <p>Date: <t t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
