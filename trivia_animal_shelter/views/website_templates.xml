<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================
         TODO 2 - The page /adopt
         Variables given by the controller:
           * animals: the animals to display
           * species: the species of the filter (e.g. 'cat'), or False
         ====================================================================== -->
    <template id="animal_list" name="Adopt: Animals">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5">
                    <h1>Adopt a friend</h1>
                    <p class="lead">These animals of the Refuge Les 4 Pattes are waiting for a family.</p>
                    <div class="mb-4 d-flex flex-wrap gap-2">
                        <a href="/adopt" t-attf-class="btn #{'btn-primary' if not species else 'btn-outline-primary'}">All</a>
                        <t t-foreach="request.env['shelter.animal']._get_species()" t-as="sp">
                            <a t-attf-href="/adopt?species=#{sp[0]}"
                               t-attf-class="btn #{'btn-primary' if species == sp[0] else 'btn-outline-primary'}"
                               t-out="sp[1]"/>
                        </t>
                    </div>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                        <t t-foreach="animals" t-as="animal">
                            <div class="col">
                                <t t-call="trivia_animal_shelter.animal_card"/>
                            </div>
                        </t>
                    </div>
                    <p t-if="not animals" class="text-muted">No animals to adopt for now.</p>
                </div>
            </div>
        </t>
    </template>

    <!-- ======================================================================
         TODO 2 - The card of an animal (variable: animal)
         The root element must be EXACTLY:
             <div class="card h-100 o_shelter_card" t-att-data-animal-id="animal.id"> ... </div>
         It shows the emoji of the species (animal.species_emoji), the name, the breed, the age,
         and a link to the page of the animal (animal.website_url).
         ====================================================================== -->
    <template id="animal_card" name="Adopt: Animal Card">
        <div class="card h-100 o_shelter_card" t-att-data-animal-id="animal.id">
            <div class="card-body text-center">
                <div class="display-3" t-out="animal.species_emoji"/>
                <h5 class="card-title mt-2" t-out="animal.name"/>
                <p class="card-text text-muted mb-1" t-if="animal.breed" t-out="animal.breed"/>
                <p class="card-text" t-if="animal.age" t-out="animal.age"/>
                <a t-att-href="animal.website_url" class="btn btn-primary stretched-link">Meet <t t-out="animal.name"/></a>
            </div>
        </div>
    </template>

    <!-- ======================================================================
         TODO 3 - The page of an animal (variable: animal)
         It shows the emoji of the species, the name, the breed, the age, the sex and the description.

         TODO 4 - The adoption form, on the same page: the fields name, email, phone and message,
         posted (method POST) to the URL of the animal followed by /request.
         Don't forget the CSRF token of the form!
         ====================================================================== -->
    <template id="animal_detail" name="Adopt: Animal">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5">
                    <a href="/adopt">← All the animals</a>
                    <div class="row mt-4">
                        <div class="col-md-4 text-center">
                            <div class="display-1" t-out="animal.species_emoji"/>
                        </div>
                        <div class="col-md-8">
                            <h1 t-out="animal.name"/>
                            <ul class="list-unstyled text-muted">
                                <li t-if="animal.breed"><b>Breed:</b> <t t-out="animal.breed"/></li>
                                <li t-if="animal.age"><b>Age:</b> <t t-out="animal.age"/></li>
                                <li t-if="animal.sex"><b>Sex:</b> <t t-out="animal.sex.capitalize()"/></li>
                            </ul>
                            <p t-if="animal.description" t-out="animal.description"/>
                            <form t-attf-action="/adopt/#{animal.id}/request" method="post" class="mt-4">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <h3>Adopt <t t-out="animal.name"/></h3>
                                <div class="mb-3">
                                    <label for="name" class="form-label">Your name</label>
                                    <input type="text" name="name" id="name" class="form-control" required="required"/>
                                </div>
                                <div class="mb-3">
                                    <label for="email" class="form-label">Your email</label>
                                    <input type="email" name="email" id="email" class="form-control" required="required"/>
                                </div>
                                <div class="mb-3">
                                    <label for="phone" class="form-label">Your phone</label>
                                    <input type="tel" name="phone" id="phone" class="form-control"/>
                                </div>
                                <div class="mb-3">
                                    <label for="message" class="form-label">Message</label>
                                    <textarea name="message" id="message" rows="4" class="form-control"/>
                                </div>
                                <button type="submit" class="btn btn-primary">Send my request</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- The page displayed after an adoption request (variables: animal, adoption_request) -->
    <template id="adoption_thanks" name="Adopt: Thank You">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5 text-center">
                    <div class="display-1" t-out="animal.species_emoji"/>
                    <h1>Thank you <t t-out="adoption_request.name"/>!</h1>
                    <p class="lead">
                        Your request to adopt <b t-out="animal.name"/> has been sent to the shelter.
                        We will contact you very soon.
                    </p>
                    <a href="/adopt" class="btn btn-primary">See the other animals</a>
                </div>
            </div>
        </t>
    </template>

    <record id="menu_adopt" model="website.menu">
        <field name="name">Adopt</field>
        <field name="url">/adopt</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="60"/>
    </record>

    <template id="s_animal_of_the_week" name="Animal of the week">
        <section class="s_animal_of_the_week pt48 pb48">
            <div class="container text-center">
                <h2>Animal of the week</h2>
                <div class="display-1">🐾</div>
                <h3>Name of the animal</h3>
                <p>Tell us why this animal is waiting for a family.</p>
                <a href="/adopt" class="btn btn-primary">See all the animals</a>
            </div>
        </section>
    </template>

    <template id="snippets" inherit_id="website.snippets" name="Shelter Snippets">
        <xpath expr="//t[@id='installed_snippets_hook']" position="after">
            <t t-snippet="trivia_animal_shelter.s_animal_of_the_week" string="Animal of the week" group="text"/>
        </xpath>
    </template>
</odoo>
