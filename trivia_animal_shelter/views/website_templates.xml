<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================
         TODO 2 - The page /adopt
         Variables given by the controller:
           * animals: the animals to display
           * species: the species of the filter (e.g. 'cat'), or False
         ====================================================================== -->
    <template id="animal_list" name="Adopt: Animals">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5">
                    <h1>Adopt a friend</h1>
                    <p class="lead">These animals of the Refuge Les 4 Pattes are waiting for a family.</p>
                    <!--
                    TODO 2: a responsive grid of the animals, with Bootstrap: one card per row on a phone, two on
                    a tablet, three on a computer. Each animal is displayed by calling the template
                    trivia_animal_shelter.animal_card.

                    ⭐ BONUS: above the grid, one button per species to filter the animals (/adopt?species=cat),
                    the buttons of the species are given by request.env['shelter.animal']._get_species().
                    -->
                    <div class="o_shelter_filters d-flex flex-wrap gap-2 mb-4">
                        <a href="/adopt" t-attf-class="btn btn-sm #{'btn-primary' if not species else 'btn-outline-primary'}">All</a>
                        <t t-foreach="request.env['shelter.animal']._get_species()" t-as="species_item">
                            <a t-attf-href="/adopt?species=#{species_item[0]}"
                               t-attf-class="btn btn-sm #{'btn-primary' if species == species_item[0] else 'btn-outline-primary'}"
                               t-out="species_item[1]"/>
                        </t>
                    </div>
                    <div class="row g-4">
                        <t t-foreach="animals" t-as="animal">
                            <div class="col-12 col-md-6 col-lg-4">
                                <t t-call="trivia_animal_shelter.animal_card"/>
                            </div>
                        </t>
                    </div>
                    <p t-if="not animals" class="text-muted mt-4">No animal is waiting for a family right now.</p>
                </div>
            </div>
        </t>
    </template>

    <!-- ======================================================================
         TODO 2 - The card of an animal (variable: animal)
         The root element must be EXACTLY:
             <div class="card h-100 o_shelter_card" t-att-data-animal-id="animal.id"> ... </div>
         It shows the emoji of the species (animal.species_emoji), the name, the breed, the age,
         and a link to the page of the animal (animal.website_url).
         ====================================================================== -->
    <template id="animal_card" name="Adopt: Animal Card">
        <div class="card h-100 o_shelter_card" t-att-data-animal-id="animal.id">
            <div class="card-body text-center">
                <div class="o_shelter_emoji mb-3" t-out="animal.species_emoji"/>
                <h3 class="card-title h4">
                    <a t-att-href="animal.website_url" class="stretched-link text-reset text-decoration-none"
                       t-out="animal.name"/>
                </h3>
                <p t-if="animal.breed" class="card-text text-muted mb-1" t-out="animal.breed"/>
                <p t-if="animal.age" class="card-text small mb-0" t-out="animal.age"/>
            </div>
        </div>
    </template>

    <!-- ======================================================================
         TODO 3 - The page of an animal (variable: animal)
         It shows the emoji of the species, the name, the breed, the age, the sex and the description.

         TODO 4 - The adoption form, on the same page: the fields name, email, phone and message,
         posted (method POST) to the URL of the animal followed by /request.
         Don't forget the CSRF token of the form!
         ====================================================================== -->
    <template id="animal_detail" name="Adopt: Animal">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5">
                    <a href="/adopt">← All the animals</a>
                    <div class="row g-5 mt-1">
                        <div class="col-12 col-lg-6">
                            <div class="o_shelter_detail_emoji mb-3" t-out="animal.species_emoji"/>
                            <h1 t-field="animal.name"/>
                            <ul class="list-unstyled lead">
                                <li t-if="animal.breed"><b>Breed:</b> <span t-out="animal.breed"/></li>
                                <li t-if="animal.age"><b>Age:</b> <span t-out="animal.age"/></li>
                                <li t-if="animal.sex"><b>Sex:</b> <span t-field="animal.sex"/></li>
                            </ul>
                            <p t-if="animal.description" t-out="animal.description" style="white-space: pre-line;"/>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="card">
                                <div class="card-body">
                                    <h2 class="h4 mb-3">Adopt <t t-out="animal.name"/></h2>
                                    <form t-attf-action="#{animal.website_url}/request" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="mb-3">
                                            <label class="form-label" for="shelter_name">Your name</label>
                                            <input type="text" class="form-control" id="shelter_name" name="name" required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label" for="shelter_email">Email</label>
                                            <input type="email" class="form-control" id="shelter_email" name="email" required="required"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label" for="shelter_phone">Phone</label>
                                            <input type="tel" class="form-control" id="shelter_phone" name="phone"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label" for="shelter_message">Message</label>
                                            <textarea class="form-control" id="shelter_message" name="message" rows="4"/>
                                        </div>
                                        <button type="submit" class="btn btn-primary">Send my request</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- The page displayed after an adoption request (variables: animal, adoption_request) -->
    <template id="adoption_thanks" name="Adopt: Thank You">
        <t t-call="website.layout">
            <div id="wrap" class="o_shelter">
                <div class="container py-5 text-center">
                    <div class="display-1" t-out="animal.species_emoji"/>
                    <h1>Thank you <t t-out="adoption_request.name"/>!</h1>
                    <p class="lead">
                        Your request to adopt <b t-out="animal.name"/> has been sent to the shelter.
                        We will contact you very soon.
                    </p>
                    <a href="/adopt" class="btn btn-primary">See the other animals</a>
                </div>
            </div>
        </t>
    </template>

    <!-- TODO 5: a menu "Adopt" in the main menu of the website, opening /adopt (model website.menu) -->
    <record id="menu_adopt" model="website.menu">
        <field name="name">Adopt</field>
        <field name="url">/adopt</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">50</field>
    </record>
    <!-- ⭐ BONUS: a building block (snippet) "Animal of the week", available in the website editor -->
        <template id="s_animal_of_the_week" name="Animal of the Week">
        <section class="s_animal_of_the_week pt48 pb48">
            <div class="container text-center">
                <h2>Animal of the week</h2>
                <p class="lead">Our animals are waiting for a family.</p>
                <a href="/adopt" class="btn btn-primary">See the animals</a>
            </div>
        </section>
    </template>

    <template id="snippets_shelter" inherit_id="website.snippets" name="Shelter Snippets">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="trivia_animal_shelter.s_animal_of_the_week" string="Animal of the Week" group="content"/>
        </xpath>
    </template>
</odoo>
