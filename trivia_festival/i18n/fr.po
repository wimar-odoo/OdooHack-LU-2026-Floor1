"2 · The welcome desk <span class=\"badge text-bg-light fw-normal font-"
"monospace ms-1\">static/src/kiosk/</span> <span class=\"badge text-bg-light "
"fw-normal font-monospace\">views/menus.xml</span>"
msgstr "2 · L’accueil <span class=\"badge text-bg-light fw-normal font-monospace ms-1\">static/src/kiosk/</span> <span class=\"badge text-bg-light fw-normal font-monospace\">views/menus.xml</span>"

