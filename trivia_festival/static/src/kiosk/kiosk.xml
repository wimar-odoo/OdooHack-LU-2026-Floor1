<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="trivia_festival.Kiosk">
        <div class="o_festival_kiosk h-100 overflow-auto bg-view">
            <div class="container py-4">
                <h1>🎪 <t t-out="this.state.event.name"/></h1>
                <p class="lead">
                    <t t-out="this.state.event.attendees"/> attendees have already arrived
                    (<t t-out="this.state.event.seats_max"/> seats).
                </p>
                <!-- ⭐ BONUS: the search box -->
                <div class="input-group mb-3">
                    <span class="input-group-text"><i class="fa fa-search"/></span>
                    <input type="text" class="form-control" placeholder="Search an attendee by name..."
                           t-model="this.search" autofocus="autofocus"/>
                </div>
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Ticket</th>
                            <th/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="this.filteredRegistrations" t-as="registration" t-key="registration.id">
                            <td t-out="registration.name"/>
                            <td t-out="registration.ticket"/>
                            <td class="text-end">
                                <span t-if="registration.attended" class="badge text-bg-success">Present</span>
                                <button t-else="" class="btn btn-primary btn-sm"
                                        t-att-disabled="this.state.loading"
                                        t-on-click="() => this.checkIn(registration)">
                                    Check in
                                </button>
                            </td>
                        </tr>
                        <tr t-if="!this.filteredRegistrations.length">
                            <td colspan="3" class="text-muted text-center">No registration found.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

</templates>
