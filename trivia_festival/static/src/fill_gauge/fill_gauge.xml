<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="trivia_festival.FillGauge">
        <div class="o_festival_fill_gauge d-flex align-items-center gap-2 w-100">
            <div class="progress flex-grow-1" style="height: 1rem;"
                 role="progressbar" aria-valuemin="0"
                 t-att-aria-valuemax="this.maxValue" t-att-aria-valuenow="this.value">
                <div t-attf-class="progress-bar {{ this.colorClass }}"
                     t-attf-style="width: {{ this.percentage }}%"/>
            </div>
            <span class="text-nowrap fw-bold" t-out="this.label"/>
        </div>
    </t>

</templates>
