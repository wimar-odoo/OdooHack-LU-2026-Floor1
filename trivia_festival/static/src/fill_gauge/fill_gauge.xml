<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="trivia_festival.FillGauge">
        <div class="progress">
            <div t-attf-class="{{this.colorClass}}" t-attf-style="width: {{this.percentage}}%;">
                <t t-out="this.value"/> / <t t-out="this.max"/> (<t t-out="this.percentage"/>%)
            </div>
        </div>
    </t>

</templates>
