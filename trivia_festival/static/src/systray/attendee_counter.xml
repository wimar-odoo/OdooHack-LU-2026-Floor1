<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="trivia_festival.AttendeeCounter">
        <div t-if="this.attendees.count() !== null"
             class="o_nav_entry o_festival_attendee_counter"
             data-tooltip="Attendees already arrived at the festival">
            <i class="oi oi-filled me-1" data-icon="group"/>
            <t t-out="this.attendees.count()"/>
        </div>
    </t>

</templates>
